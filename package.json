{
  "name": "consilium-webmcp-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "dev": "wrangler dev --local",
    "db:migrate": "wrangler d1 migrations apply consilium-webmcp-local --local",
    "deploy:check": "wrangler deploy --dry-run",
    "acceptance:hetzner": "bash scripts/hetzner-acceptance.sh",
    "release:check": "bash scripts/release-check.sh",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@types/node": "^26.4.0",
    "eslint": "latest",
    "playwright": "^1.62.1",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
