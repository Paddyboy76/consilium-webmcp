{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "consilium-webmcp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "consilium-webmcp-prod",
    "database_id": "c8152314-29a6-49f4-8007-eba51b2a2b9e",
    "migrations_dir": "migrations"
  }],
  "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "consilium-evidence-bge768-v2" }],
  "ai": { "binding": "AI" },
  "vars": {
    "APP_MODE": "cloudflare",
    "MODEL_CONFIG_VERSION": "workers-ai-json-council-v15-bounded-quote-identity",
    "PIPELINE_VERSION": "0f7f47a4116e02d59f2622824e4535cda5c92ffa2eb0648deda04bd72309bed5",
    "CONSULTATION_LIMIT_PER_HOUR": "6",
    "SESSION_KEY_VERSION": "k1",
    "INGESTION_ENABLED": "false"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
