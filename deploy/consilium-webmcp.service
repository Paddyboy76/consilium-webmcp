[Unit]
Description=Consilium WebMCP Challenge Edition
After=network.target

[Service]
Type=simple
User=patadmin
WorkingDirectory=/home/patadmin/consilium-webmcp
EnvironmentFile=-/etc/consilium-webmcp.env
ExecStart=/usr/bin/python3 -m app.server
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/patadmin/consilium-webmcp/data

[Install]
WantedBy=multi-user.target

