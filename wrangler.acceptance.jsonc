{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "consilium-webmcp-acceptance",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "consilium-webmcp-acceptance",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "APP_MODE": "fixture",
    "MODEL_CONFIG_VERSION": "council-v1",
    "PIPELINE_VERSION": "1f5efdc1c1ef895b221f8dba3ab9c6b64139eb4265eb33a154ba560aa761109f",
    "CONSULTATION_LIMIT_PER_HOUR": "6",
    "SESSION_KEY_VERSION": "k1",
    "ACCEPTANCE_DIAGNOSTICS": "safe-seed-stage"
  },
  "limits": { "cpu_ms": 30000, "subrequests": 40 }
}
